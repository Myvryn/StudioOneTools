<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudioOneTools.Avalonia.SongSelectionDialog"
        Title="Six Walls — Multiple Song Versions Found"
        Icon="/Branding/Assets/six_walls_mark.png"
        Height="320"
        Width="600"
        MinHeight="280"
        MinWidth="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Text="This folder contains multiple .song files. Select the version to analyze, or archive all versions at once. The most recently modified file is pre-selected." />

        <DataGrid x:Name="SongFilesDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  BorderBrush="{StaticResource SwHairlineSoftBrush}"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding FileName}"
                                    Header="Song"
                                    Width="*" />
                <DataGridTextColumn Binding="{Binding LastModified, StringFormat='{}{0:MMM d, yyyy  h:mm tt}'}"
                                    Header="Last Modified"
                                    Width="200" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Spacing="8">
            <Button Padding="16,6"
                    IsCancel="True"
                    Content="Cancel"
                    Click="CancelButton_OnClick" />
            <Button Padding="16,6"
                    Content="Archive All"
                    Click="ArchiveAllButton_OnClick" />
            <Button Padding="16,6"
                    IsDefault="True"
                    Content="Analyze Selected"
                    Click="AnalyzeSelectedButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
