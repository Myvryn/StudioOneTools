<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="clr-namespace:StudioOneTools.Avalonia.Branding"
        x:Class="StudioOneTools.Avalonia.SweeperWindow"
        Title="Six Walls — Folder Sweeper"
        Icon="/Branding/Assets/six_walls_mark.png"
        Height="600"
        Width="960"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Title -->
        <branding:BrandHeader Grid.Row="0"
                              Margin="0,0,0,12"
                              Screen="Folder Sweeper" />

        <!-- Root folder row -->
        <Grid Grid.Row="1" Margin="0,0,0,12" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="Root folder" />

            <TextBox x:Name="RootFolderPathTextBox"
                     Grid.Column="1"
                     Padding="8,6"
                     Text="{Binding RootFolderPath, Mode=TwoWay}"
                     TextChanged="RootFolderPathTextBox_OnTextChanged" />

            <Button Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="16,6"
                    Content="Browse..."
                    Click="BrowseButton_OnClick" />
        </Grid>

        <!-- Results DataGrid -->
        <DataGrid x:Name="ResultsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  ItemsSource="{Binding FlaggedFolders}">
            <DataGrid.Columns>

                <!-- Single-click checkbox via template column -->
                <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="&#x2714;"
                                       HorizontalAlignment="Center"
                                       ToolTip.Tip="Include in deletion" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Folder"
                                    Binding="{Binding FolderName}"
                                    Width="200"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="Reason"
                                    Binding="{Binding Reason}"
                                    Width="2*"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="Path"
                                    Binding="{Binding FolderPath}"
                                    Width="*"
                                    IsReadOnly="True" />

            </DataGrid.Columns>
        </DataGrid>

        <!-- Action buttons row -->
        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="Auto,Auto,*,Auto">

            <Button Grid.Column="0"
                    Padding="16,6"
                    IsEnabled="{Binding HasFlaggedFolders}"
                    Content="Select All"
                    Click="SelectAllButton_OnClick" />

            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,6"
                    IsEnabled="{Binding HasFlaggedFolders}"
                    Content="Deselect All"
                    Click="DeselectAllButton_OnClick" />

            <CheckBox Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"
                      IsChecked="{Binding RemoveFromRecentDocuments, Mode=TwoWay}"
                      Content="Remove from Recent Documents" />

            <Button Grid.Column="3"
                    Padding="16,6"
                    IsEnabled="{Binding CanDelete}"
                    Content="{Binding DeleteButtonText}"
                    Click="DeleteButton_OnClick" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Margin="0,8,0,0"
                Padding="10"
                Background="{StaticResource SwWindowBrush}"
                BorderBrush="{StaticResource SwHairlineBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Busy overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="5"
              Background="{StaticResource SwOverlayBrush}"
              IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="300"
                             Height="6" />
                <TextBlock Margin="0,16,0,0"
                           Foreground="White"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Text="{Binding BusyMessage}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
