<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudioOneTools.Avalonia.BackupConfirmDialog"
        Title="Six Walls — Confirm Backup"
        Icon="/Branding/Assets/six_walls_mark.png"
        Height="480"
        Width="560"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource SwAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ Border#Border">
            <Setter Property="Background" Value="{StaticResource SwAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ Border#Border">
            <Setter Property="Background" Value="{StaticResource SwAccentDeepBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Green header band -->
        <Border Grid.Row="0"
                Background="{StaticResource SwAccentBrush}"
                Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconBackup}"
                      Stroke="White"
                      StrokeThickness="1.8"
                      StrokeJoin="Round"
                      Fill="Transparent"
                      Width="32"
                      Height="32"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Confirm Backup" />
                    <TextBlock FontSize="12"
                               Foreground="#CCFFFFFF"
                               Margin="0,3,0,0"
                               Text="These songs will be synced to your backup location." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1" Margin="24,16,24,24" RowDefinitions="*,Auto,Auto,Auto">

            <!-- Folders DataGrid -->
            <DataGrid x:Name="FoldersGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      RowBackground="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Song Folder"
                                        Binding="{Binding FolderName}"
                                        Width="*" />
                    <DataGridTextColumn Header="Files to Copy"
                                        Binding="{Binding DisplayCount}"
                                        Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Total -->
            <TextBlock x:Name="TotalTextBlock"
                       Grid.Row="1"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SwAccentBrush}"
                       Margin="0,10,0,0" />

            <!-- Checkbox -->
            <CheckBox x:Name="IncludeUnusedCheckBox"
                      Grid.Row="2"
                      Content="Include unused audio takes from tracks"
                      IsChecked="True"
                      FontSize="13"
                      Margin="0,14,0,0" />

            <!-- Buttons -->
            <Grid Grid.Row="3" Margin="0,20,0,0" ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1"
                        Padding="20,8"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        Click="CancelButton_OnClick" />

                <Button Grid.Column="2"
                        Padding="20,8"
                        Classes="primary"
                        Content="Backup"
                        Click="BackupButton_OnClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
