<Window x:Class="StudioOneTools.App.RenamerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:branding="clr-namespace:StudioOneTools.App.Branding"
        mc:Ignorable="d"
        Title="Six Walls — Song ReNamer"
        Icon="pack://application:,,,/Branding/Assets/six_walls_mark.png"
        Height="500"
        Width="720"
        MinHeight="400"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_OnLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SwAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SwAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SwAccentDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SwAccentDisabledBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SwOnAccentDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SwAccentWashBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SwAccentDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SwAccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SwAccentWashHoverBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SwAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SwAccentPressBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <branding:BrandHeader Grid.Row="0"
                              Margin="0,0,0,14"
                              Screen="Song ReNamer" />

        <!-- Folder row -->
        <Grid Grid.Row="1"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Song folder" />

            <TextBox x:Name="FolderPathTextBox"
                     Grid.Column="1"
                     Padding="8,6"
                     Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="FolderPathTextBox_OnTextChanged" />

            <Button Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="16,6"
                    Content="Browse..."
                    Click="BrowseButton_OnClick" />
        </Grid>

        <!-- Middle area: placeholder or analysis section -->
        <Grid Grid.Row="2">

            <!-- Placeholder shown when no analysis is loaded -->
            <TextBlock Foreground="{StaticResource SwTextFaintBrush}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="Browse to a Studio One song folder to get started."
                       Visibility="{Binding HasNoAnalysis, Converter={StaticResource BoolToVisibility}}" />

            <!-- Analysis content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>

                    <!-- Current name band -->
                    <Border Background="{StaticResource SwAccentWashBrush}"
                            BorderBrush="{StaticResource SwAccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Current name"
                                       Foreground="{StaticResource SwTextDimBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentName}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Border Grid.Column="2"
                                    Background="#FFFFF3CD"
                                    BorderBrush="#FFFFC107"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsDefaultName, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Default name"
                                           FontSize="11"
                                           Foreground="#FF856404" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Suggestions -->
                    <StackPanel Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,16">
                        <TextBlock Text="Suggested names from .song files:"
                                   FontSize="12"
                                   Foreground="{StaticResource SwTextDimBrush}"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Style="{StaticResource SuggestionChipStyle}"
                                            Click="SuggestionChip_OnClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- New name input -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="New name" />

                        <TextBox Grid.Column="1"
                                 Padding="8,6"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Padding="14,8"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}"
                                Content="{Binding PlayButtonContent}"
                                Click="PlayButton_OnClick" />

                        <Button Padding="16,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding CanRename}"
                                Content="Rename"
                                Click="RenameButton_OnClick" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                Background="{StaticResource SwWindowBrush}"
                BorderBrush="{StaticResource SwHairlineBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Busy overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Background="{StaticResource SwOverlayBrush}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="300"
                             Height="6" />
                <TextBlock Margin="0,16,0,0"
                           Foreground="White"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Text="{Binding StatusMessage}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
