<Window x:Class="StudioOneTools.App.PathFixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:branding="clr-namespace:StudioOneTools.App.Branding"
        mc:Ignorable="d"
        Title="Six Walls — Path Fixer"
        Icon="pack://application:,,,/Branding/Assets/six_walls_mark.png"
        Height="420"
        Width="720"
        MinHeight="380"
        MinWidth="580"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <branding:BrandHeader Grid.Row="0"
                              Margin="0,0,0,12"
                              Screen="Path Fixer" />

        <!-- Song file row -->
        <Grid Grid.Row="1"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="Song file" />

            <TextBox x:Name="SongFilePathTextBox"
                     Grid.Column="1"
                     Padding="8,6"
                     Text="{Binding SongFilePath, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="SongFilePathTextBox_OnTextChanged" />

            <Button Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="16,6"
                    Content="Browse..."
                    Click="BrowseButton_OnClick" />
        </Grid>

        <!-- Analysis panel -->
        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="14"
                BorderBrush="{StaticResource SwHairlineSoftBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Margin="0,0,12,6"
                           FontWeight="SemiBold"
                           Text="Stored path" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"
                           Text="{Binding StoredPath}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,0,12,6"
                           FontWeight="SemiBold"
                           Text="Current path" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"
                           Text="{Binding CurrentPath}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,0,12,0"
                           FontWeight="SemiBold"
                           Text="Paths to fix" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding PathsToUpdate}" />
            </Grid>
        </Border>

        <!-- Fix button row -->
        <StackPanel Grid.Row="3"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
            <Button Padding="16,6"
                    IsEnabled="{Binding CanFix}"
                    Content="Fix Paths"
                    Click="FixButton_OnClick" />
            <TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SwTextFaintBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       Text="Tip: back up your .song file before fixing, in case you need to revert." />
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Margin="0,8,0,0"
                Padding="10"
                Background="{StaticResource SwWindowBrush}"
                BorderBrush="{StaticResource SwHairlineBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Busy overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="5"
              Background="{StaticResource SwOverlayBrush}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="300"
                             Height="6" />
                <TextBlock Margin="0,16,0,0"
                           Foreground="White"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Text="{Binding BusyMessage}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
