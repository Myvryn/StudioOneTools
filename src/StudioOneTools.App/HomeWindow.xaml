<Window x:Class="StudioOneTools.App.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:branding="clr-namespace:StudioOneTools.App.Branding"
        mc:Ignorable="d"
        Title="Six Walls — Tools for Studio One | Studio Pro"
        Icon="pack://application:,,,/Branding/Assets/six_walls_mark.png"
        Height="450"
        Width="1100"
        MinHeight="420"
        MinWidth="1020"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ToolCardStyle" TargetType="Button">
            <Setter Property="Height" Value="180" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource SwSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SwHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SwAccentWashBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource SwAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SwAccentPressBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SwWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <branding:BrandHeader Grid.Column="0"
                                  Margin="32,28,32,16"
                                  Caption="Select a tool to get started." />

            <Button Grid.Column="1"
                    Margin="0,0,28,0"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Click="HelpButton_OnClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Text="&#xE897;" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Help" />
                </StackPanel>
            </Button>
        </Grid>

        <UniformGrid Grid.Row="1"
                     Rows="1"
                     Columns="6"
                     Margin="16,8,16,16"
                     VerticalAlignment="Center">

                <Button Style="{StaticResource ToolCardStyle}"
                        Click="SongArchiverCard_OnClick">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource SwToolArchiverBrush}"
                                   HorizontalAlignment="Center"
                                   Text="&#xE8B7;" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="Song Archiver" />
                        <TextBlock Margin="10,5,10,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SwTextFaintBrush}"
                                   HorizontalAlignment="Center"
                                   MaxWidth="160"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Archive song folders and manage media files." />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolCardStyle}"
                        Click="UnArchiverCard_OnClick">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource SwToolUnArchiverBrush}"
                                   HorizontalAlignment="Center"
                                   Text="&#xE8B6;" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="Un-Archiver" />
                        <TextBlock Margin="10,5,10,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SwTextFaintBrush}"
                                   HorizontalAlignment="Center"
                                   MaxWidth="140"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Restore an archived song and fix its internal paths." />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolCardStyle}"
                        Click="SweeperCard_OnClick">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource SwToolSweeperBrush}"
                                   HorizontalAlignment="Center"
                                   Text="&#xE74D;" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="Folder Sweeper" />
                        <TextBlock Margin="10,5,10,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SwTextFaintBrush}"
                                   HorizontalAlignment="Center"
                                   MaxWidth="160"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Find and remove old or incomplete song folders." />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolCardStyle}"
                        Click="BackupCard_OnClick">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource SwToolBackupBrush}"
                                   HorizontalAlignment="Center"
                                   Text="&#xE74E;" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="Song Backup" />
                        <TextBlock Margin="10,5,10,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SwTextFaintBrush}"
                                   HorizontalAlignment="Center"
                                   MaxWidth="160"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Sync songs to a backup location, keeping only changed files." />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolCardStyle}"
                        Click="RenamerCard_OnClick">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource SwToolRenamerBrush}"
                                   HorizontalAlignment="Center"
                                   Text="&#xE8AC;" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="Song ReNamer" />
                        <TextBlock Margin="10,5,10,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SwTextFaintBrush}"
                                   HorizontalAlignment="Center"
                                   MaxWidth="160"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Rename the entire song package — folder, files, and references." />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolCardStyle}"
                        Click="PathFixerCard_OnClick">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource SwToolPathFixerBrush}"
                                   HorizontalAlignment="Center"
                                   Text="&#xE8AB;" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="Path Fixer" />
                        <TextBlock Margin="10,5,10,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SwTextFaintBrush}"
                                   HorizontalAlignment="Center"
                                   MaxWidth="160"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Fix broken media paths after a song is restored to a new location." />
                    </StackPanel>
                </Button>

        </UniformGrid>
    </Grid>
</Window>
