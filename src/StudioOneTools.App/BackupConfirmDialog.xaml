<Window x:Class="StudioOneTools.App.BackupConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Six Walls — Confirm Backup"
        Icon="pack://application:,,,/Branding/Assets/six_walls_mark.png"
        Height="480"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SwAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SwAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SwAccentDeepBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Green header band -->
        <Border Grid.Row="0"
                Background="{StaticResource SwAccentBrush}"
                Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="32"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           Text="&#xE74E;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Confirm Backup" />
                    <TextBlock FontSize="12"
                               Foreground="#CCFFFFFF"
                               Margin="0,3,0,0"
                               Text="These songs will be synced to your backup location." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1"
              Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Folders DataGrid -->
            <DataGrid x:Name="FoldersGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      RowBackground="White"
                      AlternatingRowBackground="{StaticResource SwSurfaceAltBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Song Folder"
                                        Binding="{Binding FolderName}"
                                        Width="*" />
                    <DataGridTextColumn Header="Files to Copy"
                                        Binding="{Binding DisplayCount}"
                                        Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Total -->
            <TextBlock x:Name="TotalTextBlock"
                       Grid.Row="1"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SwAccentBrush}"
                       Margin="0,10,0,0" />

            <!-- Checkbox -->
            <CheckBox x:Name="IncludeUnusedCheckBox"
                      Grid.Row="2"
                      Content="Include unused audio takes from tracks"
                      IsChecked="True"
                      FontSize="13"
                      Margin="0,14,0,0"
                      />

            <!-- Buttons -->
            <Grid Grid.Row="3"
                  Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Padding="20,8"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        Click="CancelButton_OnClick" />

                <Button Grid.Column="2"
                        Padding="20,8"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Backup"
                        Click="BackupButton_OnClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
