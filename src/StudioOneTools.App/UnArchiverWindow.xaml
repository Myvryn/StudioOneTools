<Window x:Class="StudioOneTools.App.UnArchiverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:branding="clr-namespace:StudioOneTools.App.Branding"
        mc:Ignorable="d"
        Title="Six Walls — Un-Archiver"
        Icon="pack://application:,,,/Branding/Assets/six_walls_mark.png"
        Height="360"
        Width="680"
        MinHeight="320"
        MinWidth="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <branding:BrandHeader Grid.Row="0"
                              Margin="0,0,0,16"
                              Screen="Un-Archiver" />

        <!-- Archive file row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Archive file" />
            <TextBox Grid.Column="1"
                     Padding="8,6"
                     Text="{Binding ArchiveFilePath, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="ArchiveFilePathTextBox_OnTextChanged" />
            <Button Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="16,6"
                    Content="Browse..."
                    Click="BrowseArchiveButton_OnClick" />
        </Grid>

        <!-- Destination folder row -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Destination" />
            <TextBox Grid.Column="1"
                     Padding="8,6"
                     Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="DestinationFolderTextBox_OnTextChanged" />
            <Button Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="16,6"
                    Content="Browse..."
                    Click="BrowseDestinationButton_OnClick" />
        </Grid>

        <!-- Extract preview row -->
        <Border Grid.Row="3"
                Margin="0,0,0,12"
                Padding="12"
                BorderBrush="{StaticResource SwHairlineSoftBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Will extract to" />
                <TextBlock Grid.Column="1"
                           TextWrapping="Wrap"
                           Text="{Binding ExtractedToPath}" />
            </Grid>
        </Border>

        <!-- Extract button -->
        <StackPanel Grid.Row="4"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
            <Button Padding="16,6"
                    IsEnabled="{Binding CanExtract}"
                    Content="Extract &amp; Fix Paths"
                    Click="ExtractButton_OnClick" />
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="5"
                Margin="0,8,0,0"
                Padding="10"
                Background="{StaticResource SwWindowBrush}"
                BorderBrush="{StaticResource SwHairlineBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Busy overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="6"
              Background="{StaticResource SwOverlayBrush}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="300" Height="6" />
                <TextBlock Margin="0,16,0,0"
                           Foreground="White"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Text="Extracting and fixing paths, please wait…" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
